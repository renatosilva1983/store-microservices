{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "ReverseProxy": {
    "Routes": {
      "catalog": {
        "ClusterId": "catalog",
        "CorsPolicy": "frontend",
        "Match": { "Path": "/api/catalog/{**remainder}" },
        "Transforms": [ { "PathPattern": "/api/{**remainder}" } ]
      },
      "auth": {
        "ClusterId": "identity",
        "CorsPolicy": "frontend",
        "Match": { "Path": "/api/auth/{**remainder}" }
      },
      "orders": {
        "ClusterId": "ordering",
        "CorsPolicy": "frontend",
        "Match": { "Path": "/api/orders/{**remainder}" }
      }
    },
    "Clusters": {
      "catalog": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5086/" }
        }
      },
      "identity": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5088/" }
        }
      },
      "ordering": {
        "Destinations": {
          "d1": { "Address": "http://localhost:5087/" }
        }
      }
    }
  }
}
