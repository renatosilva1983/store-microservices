<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.7204101">
  <!-- Projeto JavaScript do Visual Studio: permite abrir o Angular numa solution
       e usar o botão Iniciar (roda "npm start" e abre o navegador com depuração). -->
  <PropertyGroup>
    <StartupCommand>npm start</StartupCommand>
    <!-- No Build do VS só roda o npm install; o build de produção é "npm run build". -->
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist\store-web\browser\</BuildOutputFolder>
  </PropertyGroup>
</Project>
